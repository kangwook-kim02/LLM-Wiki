# LLM-Wiki 환경 설정 예시
# 이 파일을 복사하여 .env로 저장한 후 아래 값을 환경에 맞게 수정하세요.
# cp .env.example .env

# Python 실행 파일 절대경로 (예: C:\Python313\python.exe 또는 /usr/bin/python3)
PYTHON_CMD=C:\Python313\python.exe

# 프로젝트 루트 절대경로 (예: C:\Users\yourname\LLM-Wiki 또는 /home/yourname/LLM-Wiki)
PROJECT_ROOT=C:\Users\yourname\LLM-Wiki
